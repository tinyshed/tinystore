# kv, as plan/api/kv.md has it: buckets, counters, rate limits, quotas, once
# and transactions. A value travels as its row keeps it, nil, an integer or
# bin, so that the server reads what any language wrote; an SDK turns its
# types into rows and back.

# Opens a bucket of values by key. Its keys expire ttl after they are written,
# or idle after they were last read or written; not both.
message kv.BucketOpen {
  1 name: str                 # [a-z0-9][a-z0-9_-]{0,63}
  2 ttl: duration?
  3 idle: duration?
}

# A call on one key of a handle's branch.
message kv.Call {
  1 handle: uint
  2 under: [key]              # the branch's owners, outermost first; the bucket's root when empty
  3 key: key
  4 value: value?             # what a set or a create writes
  5 ttl: duration?            # the expiry a write gives, from now
  6 expiresAt: time?          # the expiry a write gives, as a time
  7 ifVersion: bin?           # the version the key must still be at
  8 n: int64?                 # what a counter adds; the requests or uses a limit is asked for, 1 when absent
}

# A key's value with what a conditional write needs.
message kv.Entry {
  1 found: bool
  2 value: value?
  3 version: bin?             # compared only for equality
  4 expiresAt: time?          # absent for a key that never expires
  5 key: key?                 # a page's entry alone
}

# What a write left: whether it wrote, and the version and expiry the key has
# now, the live key's own when a create found one.
message kv.Written {
  1 written: bool
  2 version: bin
  3 expiresAt: time?
}

message kv.Found {
  1 found: bool
}

# A branch of a handle, for a clear.
message kv.Branch {
  1 handle: uint
  2 under: [key]
}

# A page of a branch's own keys, in the byte order of their text.
message kv.List {
  1 handle: uint
  2 under: [key]
  3 after: key?               # the key the page starts after
  4 limit: uint?              # 100 when absent, 1000 at most
}

# A page of entries, as many as the limit asks and the body holds, and where
# the next page starts, when there is one.
message kv.Page {
  1 entries: [kv.Entry]
  2 next: key?
}

# Opens counters: numbers by key that only add up.
message kv.CountersOpen {
  1 name: str
  2 ttl: duration?            # a counter lasts this long from its first add
  3 durability: duration?     # kept in memory and written every interval; each add written when absent
}

message kv.Count {
  1 value: int64
}

# Opens a rate limit: rate requests a key every per, burst at once.
message kv.RateLimitOpen {
  1 name: str
  2 rate: uint
  3 per: duration
  4 burst: uint?              # the rate when absent
}

# One window of a quota: a key may use up to limit every per from its first use.
message kv.Window {
  1 name: str                 # [a-z][a-z0-9_]{0,31}
  2 limit: uint
  3 per: duration
}

message kv.QuotaOpen {
  1 name: str
  2 windows: [kv.Window]      # one to eight
}

# One window of a quota as a key stands in it.
message kv.WindowUse {
  1 name: str
  2 used: uint
  3 limit: uint
  4 left: uint
  5 resetsAt: time?           # absent for a window not started
}

# What a rate limit or a quota answers a request.
message kv.Allowance {
  1 ok: bool
  2 left: uint                # how many more would pass now
  3 retryAt: time?            # when the request would pass; absent when it did
  4 windows: [kv.WindowUse]   # a quota's, in the order it names them
}

# Opens once's answers: a function run once a key, its answer kept.
message kv.OnceOpen {
  1 name: str
  2 keep: duration?           # a day when absent
}

# An answer of once: in the server's RESPONSE, found when one was kept, and
# otherwise the run is the client's; in the client's last DATA, found with the
# answer to keep, or not found when the function failed.
message kv.Answer {
  1 found: bool
  2 value: value?
}

# A read a transaction made, which its commit checks: the key still at the
# version it was found at, or still absent.
message kv.Check {
  1 handle: uint
  2 under: [key]
  3 key: key
  4 version: bin?             # absent: the read found nothing
}

# One write of a transaction: the method it is, and its call.
message kv.Op {
  1 method: uint              # kv.set, kv.create, kv.take, kv.delete, kv.expire, kv.clear or kv.counters.add
  2 call: kv.Call
}

# A transaction across the wire: its reads' checks, then its writes, all
# applied or none. A failed check or write names its place in what.
message kv.Tx {
  1 checks: [kv.Check]
  2 writes: [kv.Op]
}

# What one write of a transaction did.
message kv.Outcome {
  1 found: bool               # a take, a delete or an expire found a live key
  2 written: bool             # a set or a create wrote
  3 value: value?             # what a take took
  4 version: bin?
  5 expiresAt: time?
  6 count: int64?             # a counter's value after its add
}

message kv.TxResults {
  1 outcomes: [kv.Outcome]
}

method 0x0101 kv.bucket.open(kv.BucketOpen) -> Handle
method 0x0102 kv.get(kv.Call) -> kv.Entry
method 0x0103 kv.has(kv.Call) -> kv.Found
method 0x0104 kv.set(kv.Call) -> kv.Written
method 0x0105 kv.create(kv.Call) -> kv.Written
method 0x0106 kv.take(kv.Call) -> kv.Entry
method 0x0107 kv.delete(kv.Call) -> kv.Found
method 0x0108 kv.expire(kv.Call) -> kv.Found
method 0x0109 kv.clear(kv.Branch) -> Empty
method 0x010a kv.list(kv.List) -> kv.Page

method 0x0110 kv.counters.open(kv.CountersOpen) -> Handle
method 0x0111 kv.counters.add(kv.Call) -> kv.Count
method 0x0112 kv.counters.get(kv.Call) -> kv.Count
method 0x0113 kv.counters.delete(kv.Call) -> kv.Found
method 0x0114 kv.counters.clear(kv.Branch) -> Empty

method 0x0120 kv.rateLimit.open(kv.RateLimitOpen) -> Handle
method 0x0121 kv.quota.open(kv.QuotaOpen) -> Handle
method 0x0122 kv.allow(kv.Call) -> kv.Allowance
method 0x0123 kv.peek(kv.Call) -> kv.Allowance
method 0x0124 kv.reset(kv.Call) -> Empty
method 0x0125 kv.refund(kv.Call) -> Empty

method 0x0130 kv.once.open(kv.OnceOpen) -> Handle
method 0x0131 kv.once.run(kv.Call) -> handover kv.Answer
method 0x0132 kv.once.get(kv.Call) -> kv.Answer
method 0x0133 kv.once.delete(kv.Call) -> kv.Found

method 0x0140 kv.tx(kv.Tx) -> kv.TxResults
