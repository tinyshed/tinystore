# jobs, as plan/api/jobs.md has it: queues of JSON values by their time, ids
# that add, set, update and cancel, repeats, schedules, limits, and workers
# whose handlers run in the client. A value travels as its JSON, which the
# server checks and keeps as it came.

# How many jobs of a queue run at once: in all, across every worker of the
# store, and in each group.
message jobs.Concurrency {
  1 total: uint?
  2 group: uint?
}

# The wait before a retry: initial, doubling each time up to max.
message jobs.Backoff {
  1 initial: duration
  2 max: duration
}

# Jobs started in any span of per.
message jobs.Rate {
  1 count: uint
  2 per: duration
}

# Opens a queue; an option left out takes its default.
message jobs.QueueOpen {
  1 name: str                     # [a-z0-9][a-z0-9_-]{0,63}
  2 attempts: uint?               # 10 when absent, the first run counted
  3 backoff: jobs.Backoff?        # 1 s doubling to 1 h when absent
  4 timeout: duration?            # how long one run may take: a minute when absent
  5 concurrency: jobs.Concurrency?  # one at a time in each worker when absent
  6 rate: jobs.Rate?
  7 dedupe: duration?             # how long a done job's id stays taken
  8 keep: duration?               # how long a failed job stays: a week when absent
  9 maxWaiting: uint?             # ten million when absent
  10 database: uint?              # a database's handle: the queue lives in its file; jobs.db when absent
}

# Opens a schedule: one repeating job the code owns, under its name, whose
# repeat replaces the one kept.
message jobs.ScheduleOpen {
  1 name: str
  2 every: duration?
  3 cron: str?                    # five fields, with timeZone
  4 timeZone: str?                # an IANA name, UTC among them
  5 attempts: uint?
  6 backoff: jobs.Backoff?
  7 timeout: duration?
}

# A call on one job: an add, a set or an update.
message jobs.Call {
  1 handle: uint
  2 id: str?                      # 1 to 1024 bytes; a set and an update need one
  3 value: json
  4 at: time?
  5 delay: duration?              # from now; not beside at
  6 group: str?
  7 every: duration?              # a repeat, which needs an id
  8 cron: str?
  9 timeZone: str?
}

# The job under an id.
message jobs.Id {
  1 handle: uint
  2 id: str
}

# Whether a call did what it asked: an add added, an update changed, a cancel
# found a job.
message jobs.Changed {
  1 changed: bool
}

# A job as its queue holds it.
message jobs.Job {
  1 found: bool
  2 id: str?
  3 value: json?
  4 state: str                    # scheduled, waiting, running, done, failed or cancelled
  5 at: time?                     # when it runs next; for one done or failed, when its last run was for
  6 attempt: uint
  7 ahead: uint                   # the jobs that run before a waiting one, up to 10,000
  8 progress: json?
  9 error: str?
  10 group: str?
  11 repeat: str?                 # as the job keeps it: @every 30s +6178ms, 10 3 * * * Europe/Berlin
  12 startedAt: time?             # the last run a handler finished
  13 endedAt: time?
}

# A page of a queue's jobs: those whose ids start with a prefix, in the byte
# order of their ids, or with no prefix and the failed state, the last failed
# first.
message jobs.List {
  1 handle: uint
  2 prefix: str?
  3 state: str?                   # scheduled, waiting, running or failed
  4 after: str?                   # the page before's next
  5 limit: uint?                  # 100 when absent, 1000 at most
}

message jobs.Page {
  1 jobs: [jobs.Job]
  2 next: str?
}

# Starts the queue's worker for the client: the server claims its jobs as they
# fall due and hands each over as a held job, no more at once than the
# client's handlers, and the client answers each. A stop, or the server's
# GOAWAY, hands no job more, and the server ends the stream with DATA·END once
# the jobs the client holds are answered and written. The client's DATA·END
# ends the worker at once, the attempt of a job it still holds failing.
message jobs.Work {
  1 handle: uint
  2 concurrency: uint?            # the handlers the client runs at once, 1024 at most: the queue's total, or one
  3 untilIdle: bool               # runDue: the server ends the stream once no job is due and none is held
}

# A job the server hands the client's worker. Its run's number names it to the
# answer, a step and a keep; a cancel sends it again, cancelled, so that its
# handler stops.
message jobs.Held {
  1 run: uint
  2 id: str?
  3 value: json?
  4 at: time                      # when the run was due
  5 attempt: uint                 # the first being 1
  6 group: str?
  7 cancelled: bool
}

# The client's answer for a held job: how its run ended, or how far it got,
# which settles nothing; or a stop, which names no run. An answer for a job a
# cancel took settles nothing.
message jobs.Answer {
  1 run: uint
  2 how: str                      # done, retry, snooze, fail, back, progress or stop
  3 at: time?                     # when a retry or a snooze runs again; a retry without one waits its backoff
  4 error: str?                   # why a retry or a failure
  5 progress: json?               # 4 KiB at most
  6 delay: duration?              # from now on the server's clock; not beside at
}

# A step of a held job's run: jobs.step asks for its kept answer, jobs.keep
# keeps one.
message jobs.Step {
  1 run: uint
  2 name: str                     # 1 to 256 bytes
  3 answer: json?                 # jobs.keep's: 1 MiB at most
}

message jobs.Kept {
  1 found: bool
  2 answer: json?
}

# One write of a transaction: an add, a set or an update with its call, or a
# cancel with its id.
message jobs.Op {
  1 method: uint                  # jobs.add, jobs.set, jobs.update or jobs.cancel
  2 call: jobs.Call?
  3 id: jobs.Id?
}

# A transaction of jobs.db across the wire: its writes, all applied or none.
# One that fails names its place in what, as write.
message jobs.Tx {
  1 writes: [jobs.Op]
}

# What each write of a transaction did, in their order: whether an add added,
# an update changed or a cancel found a job; a set changes always.
message jobs.TxResults {
  1 outcomes: [jobs.Changed]
}

method 0x0201 jobs.queue.open(jobs.QueueOpen) -> Handle
method 0x0202 jobs.schedule.open(jobs.ScheduleOpen) -> Handle
method 0x0203 jobs.add(jobs.Call) -> jobs.Changed
method 0x0204 jobs.set(jobs.Call) -> Empty
method 0x0205 jobs.update(jobs.Call) -> jobs.Changed
method 0x0206 jobs.cancel(jobs.Id) -> jobs.Changed
method 0x0207 jobs.get(jobs.Id) -> jobs.Job
method 0x0208 jobs.list(jobs.List) -> jobs.Page
method 0x0209 jobs.work(jobs.Work) -> exchange jobs.Held for jobs.Answer
method 0x020a jobs.step(jobs.Step) -> jobs.Kept
method 0x020b jobs.keep(jobs.Step) -> Empty
method 0x020c jobs.watch(jobs.Id) -> download jobs.Job until Empty
method 0x020d jobs.tx(jobs.Tx) -> jobs.TxResults
