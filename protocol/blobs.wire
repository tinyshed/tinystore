# blobs, as docs/guides/blobs/README.md has it: files by path in named sets, written
# whole and replaced whole. A file's bytes travel as DATA, a piece a message,
# within the credit the side that takes them grants: a get's from the server,
# an upload's from the client. Every call names its files by a handle, the
# folder it stands in by its segments, and a path within that folder; what a
# file carries comes back with its path within the same folder.

# Opens a set of files by name, made the first time.
message blobs.Open {
  1 name: str           # [a-z0-9][a-z0-9_-]{0,63}
  2 ttl: duration?      # the term of every file written without its own
  3 maxFileSize: uint?  # the largest file a write may leave
  4 database: uint?     # a database's handle: the files live in its file, and put, head, delete, copy and rename join its transactions; blobs.db when absent
  5 idle: duration?     # the term of every file written without its own, from its last get or head; never beside ttl
  6 maxSize: uint?      # the set's ceiling, kept in the set: an open with another is a conflict
  7 whenFull: str?      # evict or refuse, what a write past the ceiling does; kept with it
}

# Where a call stands: the files, a folder's segments, a path within it.
message blobs.At {
  1 handle: uint
  2 folder: [str]
  3 path: str
}

# What a file carries: what serving it needs.
message blobs.Info {
  1 path: str           # within the folder the call stood in
  2 size: uint
  3 etag: str           # the SHA-256 of its bytes in hex, quoted
  4 contentType: str
  5 lastModified: time
  6 expires: time?
  7 meta: {str}?
}

# A write of a whole file: a put, or with create a write only where no file
# is. Its bytes are in the message, or, for an upload, the DATA that follow.
message blobs.Write {
  1 handle: uint
  2 folder: [str]
  3 path: str
  4 contentType: str?
  5 meta: {str}?
  6 ttl: duration?      # the file's own term, from its write
  7 ifMatch: str?       # the ETag of the one file it may replace
  8 size: uint?         # the body's length: one longer or shorter is refused
  9 create: bool        # writes only where no file is
  10 bytes: bin         # a put's whole body; nothing for an upload
}

# What a write wrote: none when a create found a file there.
message blobs.Written {
  1 info: blobs.Info?
}

# A piece of a file's bytes: an upload's DATA from the client, a read's from
# the server. A piece of a growing directory's file brings the file's size
# and time as it was read, so that the reader sees it moved.
message blobs.Piece {
  1 bytes: bin
  2 size: uint?
  3 lastModified: time?
}

# A get's answer: what the file carries, none when there is no file, and all
# its bytes when they fit one message; a larger file's are left to blobs.read,
# so that a read of a range sends no byte before it.
message blobs.Got {
  1 info: blobs.Info?
  2 bytes: bin          # the whole file, or nothing when it is larger
}

# A read of a file's bytes, as S3's GET with a range and If-Match: the whole
# file, checked, its last piece sent once its bytes matched their SHA-256 and a
# changed byte ending the stream corrupt instead; or a range, not checked.
message blobs.Read {
  1 handle: uint
  2 folder: [str]
  3 path: str
  4 ifMatch: str?       # the ETag a get gave: another file there, or none, is a conflict
  5 offset: uint?       # from the first byte when absent
  6 length: uint?       # to the last byte when absent
}

message blobs.Head {
  1 info: blobs.Info?
}

message blobs.Delete {
  1 handle: uint
  2 folder: [str]
  3 path: str
  4 ifMatch: str?
}

# A copy or a rename: from a path to another of the same folder. A file at
# to is a conflict, unless ifMatch names the version to replace.
message blobs.Move {
  1 handle: uint
  2 folder: [str]
  3 from: str
  4 to: str
  5 ifMatch: str?
}

message blobs.Expire {
  1 handle: uint
  2 folder: [str]
  3 path: str
  4 after: duration
}

message blobs.Found {
  1 found: bool
}

# A page of a folder's files, in the byte order of their paths.
message blobs.List {
  1 handle: uint
  2 folder: [str]
  3 prefix: str         # text within the folder
  4 after: str?         # a page's next
  5 limit: uint?        # 1000 at most, and when absent
}

message blobs.Page {
  1 files: [blobs.Info]
  2 next: str?
}

message blobs.Folder {
  1 handle: uint
  2 folder: [str]
}

message blobs.Usage {
  1 count: uint
  2 size: uint
  3 maxSize: uint?      # the set's ceiling, none when it keeps none
  4 evictions: uint     # the files the ceiling removed since the store opened
}

# A change of a set's ceiling, which every handle follows from its commit:
# a lower one evicts at once, and one the set keeps already writes nothing.
message blobs.SetMaxSize {
  1 handle: uint
  2 maxSize: uint?      # none removes the ceiling
  3 whenFull: str?      # evict or refuse; what the set does now when absent
  4 ifCurrent: uint?    # changes it only while the set keeps this ceiling: another is a conflict
}

# Removes files in the eviction's order until the set holds at most to
# bytes, a batch of 10,000 a commit; a refusing set is invalid.
message blobs.Trim {
  1 handle: uint
  2 to: uint
}

message blobs.Trimmed {
  1 evictions: uint
  2 freed: uint         # the files' sizes, as usage counts them
}

# Opens a directory by name: a folder of the server's machine, which the
# store lists and reads and never writes. Its handle takes get, head, list,
# usage and read as a set of files' does, each answered from the list the
# last scan wrote but a get's and a read's bytes, which come from the disk;
# every call that writes a file is invalid. A connection that came with a
# token names no path: it opens the directory the server was given under the
# name, and one the server was not given is invalid.
message blobs.Directory {
  1 name: str           # [a-z0-9][a-z0-9_-]{0,63}, never a set of files' name too
  2 path: str?          # the folder on the server's machine; the server's own when absent
  3 every: duration?    # a scan on the store's background work, a period apart
  4 ignore: [str]       # names a scan passes over, * for any run of a name's characters
  5 growing: bool       # a read holds to no version and goes up to the size now
}

# What a scan found, and what the list holds once it ended.
message blobs.Scanned {
  1 added: uint
  2 changed: uint
  3 removed: uint
  4 skipped: uint       # what it met and could not list: a link, a folder it cannot read, another disk
  5 count: uint
  6 size: uint
}

# The changes of a directory past a cursor, from the first file it listed
# when absent.
message blobs.Since {
  1 handle: uint
  2 after: str?         # a page's next
}

message blobs.Change {
  1 path: str           # the whole path in the directory
  2 change: str         # added, changed or removed
  3 info: blobs.Info?   # none once removed
}

# A page of changes in the order the scans wrote them, 1000 at most; next is
# always there, with no items the cursor to ask from after the next scan.
message blobs.Changes {
  1 items: [blobs.Change]
  2 next: str
}

read  0x0401 blobs.open(blobs.Open)             -> Handle
write 0x0402 blobs.put(blobs.Write)             -> blobs.Written
write 0x0403 blobs.upload(blobs.Write)          -> exchange blobs.Written for blobs.Piece
read  0x0404 blobs.get(blobs.At)                -> blobs.Got
read  0x0405 blobs.head(blobs.At)               -> blobs.Head
write 0x0406 blobs.delete(blobs.Delete)         -> Empty
write 0x0407 blobs.copy(blobs.Move)             -> blobs.Info
write 0x0408 blobs.rename(blobs.Move)           -> blobs.Info
write 0x0409 blobs.expire(blobs.Expire)         -> blobs.Found
read  0x040a blobs.list(blobs.List)             -> blobs.Page
read  0x040b blobs.usage(blobs.Folder)          -> blobs.Usage
write 0x040c blobs.clear(blobs.Folder)          -> Empty
read  0x040d blobs.read(blobs.Read)             -> download blobs.Piece until Empty
read  0x040e blobs.directory(blobs.Directory)   -> Handle
write 0x040f blobs.scan(blobs.Folder)           -> blobs.Scanned
read  0x0410 blobs.changes(blobs.Since)         -> blobs.Changes
write 0x0411 blobs.forget(blobs.Folder)         -> Empty
write 0x0413 blobs.setMaxSize(blobs.SetMaxSize) -> Empty
write 0x0414 blobs.trim(blobs.Trim)             -> blobs.Trimmed
