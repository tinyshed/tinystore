# sql, as docs/guides/sql/README.md has it: the application's databases, their
# migrations, statements as text and the values of their ?s, rows, batches
# and transactions. A value travels as SQLite keeps it, nil, an integer, a
# float, a str or bin; an SDK turns its types into those and back, and builds
# its queries into text and values before they leave.

# A migration as its file has it: the name that numbers it, and its SQL.
message sql.Migration {
  1 name: str         # 0001_notes.sql
  2 sql: str
}

# Opens a database. Migrations, when given, are applied and checked; without
# them the file opens as it is. One that backups leave out lies in local/
# rather than sql/, and a name whose file lies in the other folder is invalid.
message sql.Open {
  1 name: str         # [a-z0-9][a-z0-9_-]{0,63}
  2 migrations: [sql.Migration]?
  3 durability: str?  # full or os: how far its commits go before they return; the store's own when absent
  4 backup: bool?     # false: no backup takes it, nor any node; true when absent
}

# A statement's text and the values of its ?s, in order. In a batch it may
# be a call of another engine instead, with its request in body and no
# text, which commits with the batch's rows: jobs.add on a queue kept in the
# database's file, or records.append on a stream opened through the
# database, whose events reach the stream before the batch answers.
message sql.Text {
  1 text: str
  2 values: [cell]
  3 method: uint?     # in a batch, jobs.add or records.append: the call in body
  4 body: bin?
}

# A statement on a database: a write, or a read answered by its columns.
message sql.Statement {
  1 handle: uint
  2 text: str
  3 values: [cell]
}

# A column a statement's rows are ordered by, named as its rows name it.
message sql.Order {
  1 column: str
  2 descending: bool
}

# What a statement gives back: its rows, one row or none, one value, or each
# row as the reader reads it. A write with returning runs on the writer, its
# rows given once it is durable. Each reads one snapshot of five seconds at
# most; with order, the columns its text orders its rows by, a unique one
# last, it reads on past that after the last row it sent, and without it
# fails limit there.
message sql.Query {
  1 handle: uint
  2 text: str
  3 values: [cell]
  4 want: str         # all, one, scalar or each
  5 order: [sql.Order]?
}

# Rows a statement gave, a part of them a message: the first part names the
# columns, and every row holds a value a column, in their order.
message sql.Rows {
  1 columns: [str]
  2 rows: [[cell]]
}

# A column of a statement's rows, a part of it a message, as one of three. A
# column of INTEGERs alone goes as integers and one of REALs alone as reals,
# 8 bytes a row, little end first; where a row holds NULL its bit of nulls is
# set, and its value is 0 among integers and a NaN among reals, which SQLite
# keeps none of. Any other column goes as values: text, blobs, and INTEGERs
# beside REALs, neither read as the other.
message sql.Column {
  1 name: str
  2 integers: bin?    # an int64 a row
  3 reals: bin?       # a float64 a row
  4 nulls: bin?       # a bit a row, a byte's lowest first, set where the row holds NULL; absent when none does
  5 values: [cell]?
}

# Rows a statement gave, by their columns, a part of them a message: every
# part holds every column, in the statement's order and as the same one of
# three, for the same rows.
message sql.Columns {
  1 rows: uint        # the rows of this part
  2 total: uint       # the rows of every part
  3 columns: [sql.Column]
}

# What a write changed: the rows, and SQLite's rowid of the row it inserted,
# 0 when it inserted none.
message sql.Done {
  1 changes: uint
  2 lastInsertRowid: int64
}

# Writes known before they run, written as one in a shared commit: its
# statements, the adds of a queue kept in the database's file, and the
# appends of a stream opened through the database.
message sql.Batch {
  1 handle: uint
  2 statements: [sql.Text]
}

# What each write of a batch did, in their order: a job's add changed one
# job, or none when its id was taken, and a stream's append the events its
# stream holds no id of.
message sql.Batched {
  1 done: [sql.Done]
}

# Opens a transaction: it holds the database's writer until the client's last
# DATA, five seconds at most.
message sql.TxOpen {
  1 handle: uint
}

# A transaction's call, or its end: the last DATA commits, or not. A call is
# a statement, or a call of kv or jobs on a bucket or a queue kept in the
# database's file: a method of theirs with its request, kv.set or jobs.add,
# which runs in the transaction; or records.append on a stream opened
# through the database, whose events reach the stream once the transaction
# commits, before its last DATA answers.
message sql.TxCall {
  1 text: str
  2 values: [cell]
  3 want: str         # all, one, scalar or exec; call for a method; nothing in the last
  4 commit: bool      # in the last: true commits, false rolls back
  5 method: uint?     # with want call: the method, its request in body
  6 body: bin?
  7 parts: bool       # with want all: the rows may come in several answers, each within the client's credit
}

# A call's answer: its rows, what it changed, a method's answer, or why it
# failed, which leaves the transaction as it was before the call. A call
# that asked for parts may have its rows in several answers, every one but
# the last saying more; one that did not is refused rows past one answer.
message sql.TxAnswer {
  1 rows: sql.Rows?
  2 done: sql.Done?
  3 failure: Failure?
  4 body: bin?        # what a method answered, as its own answer
  5 more: bool        # rows of the same call follow in the next answer
}

# A column a statement answers, without its rows: its name, and the type its
# table declares for it where it is a table's own column, as SQLite keeps it.
message sql.DescribedColumn {
  1 name: str
  2 declared: str?    # absent for an expression
}

# A statement's columns in its order, whether or not it answers a row: it is
# compiled on a reader and nothing of it runs. One that writes is invalid.
message sql.Described {
  1 columns: [sql.DescribedColumn]
}

read  0x0301 sql.open(sql.Open)          -> Handle
read  0x0302 sql.query(sql.Query)        -> download sql.Rows until sql.Rows
write 0x0303 sql.exec(sql.Statement)     -> sql.Done
write 0x0304 sql.batch(sql.Batch)        -> sql.Batched
write 0x0305 sql.tx(sql.TxOpen)          -> exchange sql.TxAnswer for sql.TxCall
read  0x0306 sql.columns(sql.Statement)  -> download sql.Columns until sql.Columns
read  0x0307 sql.describe(sql.Statement) -> sql.Described
