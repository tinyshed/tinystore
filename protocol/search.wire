# search, as docs/guides/search/README.md has it: indexes by name, documents of JSON
# set by id with a vector or none, found again by their words, their vector
# or both, kept to the documents a filter passes; and a table's index, kept
# in a database's file, whose documents are the table's rows. A vector
# travels as its floats' bytes, little-endian, four a dimension.

# Opens an index, made the first time; one that holds other settings is
# changed to these, as docs/guides/search/rebuilds.md has it. A read
# connection opens an index only as it is. With a database, the index
# follows a table of it: its fields and filters are columns.
message search.Open {
  1 name: str                        # [a-z0-9][a-z0-9_-]{0,63}
  2 fields: [search.Field]           # in order; none for a document that is its own text
  3 filters: [str]                   # the fields a search may filter by
  4 typoTolerance: bool?             # on when absent
  5 dimensions: uint?                # the vectors' dimensions; none for an index without vectors
  6 recall: float?                   # above 0 and below 1; exact when absent
  7 vectorWeight: float?             # 0.5 when absent
  8 rerank: bool
  9 manual: bool                     # a change that needs reading again waits for reindex
  10 reindex: bool                   # reads the index again beside itself
  11 database: uint?                 # a database's handle: the index follows a table in its file
  12 table: str?                     # the table a database's index follows
  13 key: str?                       # the table's column of unique values; its primary key when absent
  14 vectorColumn: str?              # the column of each row's vector, a blob of little-endian floats
  15 layouts: [str]                  # the keyboard layouts its readers type with: ru and en, or none
  16 keys: [str]                     # a key of several columns, in place of key: their values unique together
  17 synonyms: {str}                 # each short form, one word, with the phrase of 1 to 8 words it stands for
}

# A field a search reads, by its path into the document, and what a word
# found there weighs.
message search.Field {
  1 path: str
  2 weight: float                    # above 0, at most 1000
}

# A document set by its id, replacing it whole.
message search.Set {
  1 handle: uint
  2 id: str                          # 1 to 1024 bytes
  3 value: json                      # 1 MiB at most
  4 vector: bin?                     # four bytes a dimension, little-endian floats
  5 noVector: bool                   # the document has no vector, on an index with vectors
}

# Documents set in one commit, all of them or none: 1,000 at most, and no more
# than one request body holds, 2 MiB from every SDK.
message search.SetMany {
  1 handle: uint
  2 documents: [search.Document]
}

message search.Document {
  1 id: str
  2 value: json
  3 vector: bin?
  4 noVector: bool
}

message search.Key {
  1 handle: uint
  2 id: str
}

message search.Deleted {
  1 deleted: bool
}

message search.Got {
  1 found: bool
  2 value: json?
}

# A search: by `text`'s words, `vector`, or both, kept to what `where` passes.
message search.Query {
  1 handle: uint
  2 text: str
  3 vector: bin?
  4 vectorWeight: float?             # this search's, in place of the index's
  5 rerank: bool
  6 where: json?                     # the conditions, as docs/wire.md's "search's where" writes them
  7 offset: uint
  8 limit: uint?                     # 10 when absent; offset and limit together 1000 at most
  9 prefix: bool                     # the last word read as the start of a word too, as a search box types
  10 prefixEvery: bool               # every word read so, a document holding a word for each first; in place of prefix
  11 matches: str?                   # utf8, utf16 or chars: each hit says where it matched, counted in that unit
  12 minSimilarity: float?           # the least cosine a document's vector has for the vector to find it
  13 statements: [search.Statement]  # what where's {"statement": n} names, by its place
  14 total: bool                     # counts what it finds as well, exactly up to 10,000; invalid beside a vector
  15 snippet: search.Cut?            # each hit's snippet of a field, around its first match there
}

# The snippet a search cuts of each hit: of which field, a path as the
# index's fields name it, how many characters on each side of the field's
# first match, and what its marks count, as a query's matches do.
message search.Cut {
  1 field: str
  2 around: uint?                    # 1 to 1000; 80 when absent
  3 unit: str                        # utf8, utf16 or chars
}

# A statement of a table's index's database whose rows give one column, as
# sql.Statement's text and values: a where keeps to the values it gives.
message search.Statement {
  1 text: str
  2 values: [cell]
}

# A hit: a document and its value, or a table's row, a value a column of
# the answer's columns, as sql.Rows holds one, where the search's words
# matched it when the query asked, and what each half of the search gave it.
message search.Hit {
  1 id: str
  2 value: json                      # null for a table's row
  3 score: float
  4 row: [cell]?
  5 matches: [search.Match]?
  6 textScore: float?                # its words' score, where they found it among their best
  7 similarity: float?               # its vector's cosine with the search's, where both have one
  8 snippet: search.Snippet?         # when the query asked for one and the hit holds the field
}

# The piece of a field around a hit's first match there, the field's own
# text with … where it was cut; its start, without marks, where the hit
# matched elsewhere or by its vector alone.
message search.Snippet {
  1 text: str
  2 marks: [search.Mark]             # every match inside text, in its order, counted in the cut's unit
  3 item: uint?                      # the string's place in a field that holds a list
}

message search.Mark {
  1 start: uint
  2 end: uint
}

# Where a search's word matched a hit: a range of a field's text, or of a
# string of a field that holds a list, counted in the unit the query asked:
# bytes of UTF-8, units of UTF-16 or code points. The whole word for a word
# found as written, by its stem or once corrected; the letters typed for a
# word a prefix began.
message search.Match {
  1 field: str                       # the field's path or the table's column; empty for a document that is its own text
  2 item: uint?                      # the string's place in a field that holds a list
  3 start: uint
  4 end: uint
  5 word: str                        # the query's word, as its text wrote it
}

message search.Found {
  1 hits: [search.Hit]
  2 corrected: str?                  # the text the search read in fact, when a word was read as another
  3 columns: [str]?                  # the columns of a table's index's rows
  4 total: search.Total?             # how many it finds, when the query asked
}

# How many documents a search finds, under its where and whatever its offset
# and limit: exactly up to 10,000, and past it 10,000 and atLeast.
message search.Total {
  1 count: uint
  2 atLeast: bool
}

# Where an index stands: ready, rebuilding and how far, or failed and why.
message search.Status {
  1 state: str                       # ready, rebuilding or failed
  2 done: float                      # the share a rebuild has read
  3 error: str                       # why a rebuild failed
}

message search.Name {
  1 name: str
  2 database: uint?                  # a database's handle, for a table's index
}

message search.Dropped {
  1 dropped: bool
}

# An index as the store's search.db holds it.
message search.Index {
  1 name: str
  2 documents: uint
  3 vectors: uint
  4 opened: time?                    # when a program last opened it
  5 state: str
  6 done: float
  7 error: str
}

message search.Listed {
  1 indexes: [search.Index]
}

# One question asked of several indexes in one call, as a "find anything"
# box asks it: the store's indexes of documents searched in one snapshot of
# search.db, a table's index in a snapshot of its database's file.
message search.ManyQuery {
  1 text: str                        # every index's, as a query's text
  2 among: [search.Among]            # 1 to 32, in order; the same index twice with another where
}

# One index a ManyQuery asks, and its search as a query of it alone says it:
# its where, offset, limit, prefix, matches and snippet; its own text,
# vector or total are invalid.
message search.Among {
  1 query: search.Query              # offset and limit together 1000 at most, limit 10 when absent
  2 boost: float?                    # what its hits weigh in merged, above 0; 1 when absent
}

# Each index's group in the order asked, and every group's hits in one
# order, by reciprocal rank fusion: the hit at rank r of its index, from 1
# and counting its group's offset, weighs boost / (60 + r); equal weights by
# the group asked first, then rank.
message search.ManyFound {
  1 groups: [search.Group]
  2 merged: [search.Merged]
}

# An index's hits, the best by its own scores first, or why its search failed.
message search.Group {
  1 index: str                       # the index's name
  2 hits: [search.Hit]               # none where it failed
  3 corrected: str?                  # as search.Found's
  4 columns: [str]?                  # the columns of a table's index's rows
  5 more: bool                       # the index has hits past the group's offset and limit
  6 failure: Failure?                # why its search failed
}

# A hit of merged, by its group's place and its own place in that group's hits.
message search.Merged {
  1 group: uint
  2 hit: uint
}

read  0x0b01 search.open(search.Open)            -> Handle
write 0x0b02 search.set(search.Set)              -> Empty
write 0x0b03 search.setMany(search.SetMany)      -> Empty
# Answers whether the index held the document.
write 0x0b04 search.delete(search.Key)           -> search.Deleted
read  0x0b05 search.get(search.Key)              -> search.Got
read  0x0b06 search.search(search.Query)         -> search.Found
read  0x0b07 search.status(Handle)               -> search.Status
# Drops an index and every document it holds, in the background.
write 0x0b08 search.dropIndex(search.Name)       -> search.Dropped
read  0x0b09 search.list(Empty)                  -> search.Listed
# Fails only where every index failed, with the first failure.
read  0x0b0a search.searchMany(search.ManyQuery) -> search.ManyFound
