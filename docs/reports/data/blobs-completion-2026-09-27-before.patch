+func (s *Store) createUpload(id int64) (*os.File, error) {
+	s.nameCalls.Lock()
+	defer s.nameCalls.Unlock()
+	return s.root.OpenFile(uploadName(id), os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)
+}
