# The image takes what it builds from and nothing else: the Rust of the store
# and its command, the SDK, the server and the site already built.
*
!rust-toolchain.toml
!Cargo.toml
!Cargo.lock
!crates
!sdk/js/package.json
!sdk/js/src
!web/package.json
!web/bun.lock
!web/server
!web/src/lib/events.ts
!web/build
**/*_tests.rs
**/node_modules
web/server/*.test.ts
web/server/testing.ts
