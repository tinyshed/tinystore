{
	"name": "tinystore-web",
	"version": "0.0.0",
	"description": "The TinyStore site: the documentation in docs/, prerendered by SvelteKit and served by Bun into a TinyStore of its own",
	"license": "Apache-2.0",
	"private": true,
	"type": "module",
	"engines": {
		"bun": ">=1.4.2"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"serve": "bun server/index.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p server && biome check .",
		"check:write": "biome check --write .",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"test": "bun test",
		"readme": "bun src/lib/content/readme.ts"
	},
	"dependencies": {
		"@tinyshed/tinystore": "file:../sdk/js",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/bun": "^1.4.2",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"github-slugger": "^2.0.0",
		"hast-util-to-html": "^9.0.5",
		"hast-util-to-string": "^3.0.1",
		"hastscript": "^9.0.1",
		"mdast-util-to-string": "^4.0.0",
		"rehype-raw": "^7.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"remark-stringify": "^11.0.0",
		"shiki": "^4.5.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"vite": "^8.3.0"
	}
}
