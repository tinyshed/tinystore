{
	"name": "tinystore",
	"version": "0.0.0",
	"description": "TinyStore for Bun and Node: kv, jobs, blobs, SQL, records and metrics in one directory, served by a sidecar",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tinyshed/tinystore.git",
		"directory": "sdk/js"
	},
	"type": "module",
	"engines": {
		"bun": ">=1.4",
		"node": ">=22"
	},
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"bin": {
		"tinystore": "bin/tinystore.js"
	},
	"files": [
		"src",
		"dist",
		"bin",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "biome check . && tsc --noEmit",
		"check:write": "biome check --write .",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"test": "bun test",
		"coverage": "bun test --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	}
}
